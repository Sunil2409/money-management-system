#!/bin/bash
set -euo pipefail

# 1. Configure 2 GB Linux Swapfile on EBS
echo "=== Configuring 2GB Swapfile ==="
if [ ! -f /swapfile ]; then
    fallocate -l 2G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=2048
    chmod 600 /swapfile
    mkswap /swapfile
    swapon /swapfile
    echo '/swapfile none swap sw 0 0' >> /etc/fstab
    
    # Kernel tuning for low-memory stability
    sysctl vm.swappiness=10
    echo 'vm.swappiness=10' >> /etc/sysctl.conf
    sysctl vm.vfs_cache_pressure=50
    echo 'vm.vfs_cache_pressure=50' >> /etc/sysctl.conf
fi

# 2. Install Docker and Docker Compose Plugin
echo "=== Installing Docker ==="
apt-get update -y
apt-get install -y ca-certificates curl gnupg lsb-release unzip awscli

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg

echo \
  "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu \
  $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | \
  tee /etc/apt/sources.list.d/docker.list > /dev/null

apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin

systemctl enable docker
systemctl start docker
usermod -aG docker ubuntu

# 3. Create application directories
mkdir -p /opt/moneymanager
chown -R ubuntu:ubuntu /opt/moneymanager

# 4. Write environment metadata
cat << 'EOF' > /opt/moneymanager/.app-env
AWS_DEFAULT_REGION=${aws_region}
AWS_STORAGE_BUCKET_NAME=${s3_bucket_name}
ENVIRONMENT=${environment}
EOF

echo "=== Bootstrap Completed ==="