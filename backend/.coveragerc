[run]
source = .
omit =
    */migrations/*
    manage.py
    config/asgi.py
    config/wsgi.py
    conftest.py
    */tests.py
    */test_*.py
    transactions/tasks.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.
    raise NotImplementedError
show_missing = True
